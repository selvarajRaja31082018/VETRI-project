NODE_ENV=development
PORT=5000

DB_HOST=localhost
DB_PORT=3306
DB_NAME=vetri
DB_USER=root
DB_PASSWORD=

JWT_SECRET=
JWT_EXPIRES_IN=1d

FRONTEND_URL=http://localhost:5173

# Seed credentials for the development administrator (db:seed)
SEED_ADMIN_EMAIL=admin@vetri.local
SEED_ADMIN_PASSWORD=

# --- Outbound mail (optional) ----------------------------------------------
# Used only to email a visitor pass. Leave SMTP_HOST unset to disable the
# feature - the API then reports it as unavailable and the UI greys the button
# out, rather than failing at send time. Never commit real credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Leave unset to infer from the port (implicit TLS on 465, STARTTLS otherwise).
SMTP_SECURE=
MAIL_FROM=VETRI <no-reply@example.com>
